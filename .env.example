APPROVAL_HOLD_HOURS=24
NODE_ENV=development
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PORT=5001
QR_SECRET=change-me-qr-secret
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Brevo transactional email (go live when key is set)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=fuse.contact@fuseevents.net
EMAIL_FROM_NAME=FUSE Events
EMAIL_REPLY_TO=fuse.contact@fuseevents.net
EMAIL_NOTIFY_TO=fuse.contact@fuseevents.net
